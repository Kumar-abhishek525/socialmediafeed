{
  "name": "social-media-feed",
  "version": "1.0.0",
  "description": "Full-stack Social Media Feed Application with Real-Time WebSockets",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:css": "npx @tailwindcss/cli -i src/input.css -o public/css/tailwind.css --minify",
    "watch:css": "npx @tailwindcss/cli -i src/input.css -o public/css/tailwind.css --watch",
    "test": "node test_api.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  },
  "keywords": ["social-media", "feed", "websockets", "realtime", "sqlite", "express"],
